<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.effect.Reflection?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<!--BORDERPANE-->
<BorderPane
        prefHeight="460.0"
        prefWidth="780.0"
        minHeight="-Infinity"
        minWidth="-Infinity"
        maxHeight="-Infinity"
        maxWidth="-Infinity"
        style="-fx-background-color: #222222;"
        stylesheets="@loginPage.css"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="Login.TitleScreenController">


    <!--RIGHT (LOGIN + SIGNUP FORM SECTION)-->
    <right>
        <VBox prefWidth="332.0" styleClass="vbox_background_right" BorderPane.alignment="CENTER">

            <!-- Motto -->
            <children>
                <VBox alignment="BOTTOM_CENTER" prefHeight="131.0" prefWidth="332.0">
                    <children>
                        <Text text="If you want to be a STICKMAN " strokeType="OUTSIDE">
                            <font><Font name="System Bold" size="24.0" /></font>
                            <effect><Glow /></effect>
                        </Text>

                        <Text text="you gotta have a STICKPLAN" strokeType="OUTSIDE">
                            <font><Font name="System Bold" size="20.0" /></font>
                            <effect><Glow /></effect>
                        </Text>
                    </children>
                </VBox>

                <!--LOGIN FORM-->
                <VBox fx:id="loginForm">

                    <!--Username-->
                    <HBox alignment="CENTER"
                          prefHeight="40.0"
                          prefWidth="332.0">
                        <children>
                            <TextField
                                    fx:id="loginUsername"
                                    prefHeight="38.0"
                                    prefWidth="267.0"
                                    promptText="Username"
                                    style="-fx-background-radius: 50; -fx-border-radius: 50;">
                                <font><Font size="14.0" /></font>
                            </TextField>
                        </children>
                        <VBox.margin><Insets top="20.0" /></VBox.margin>
                    </HBox>

                    <!--Password-->
                    <HBox
                            alignment="CENTER"
                            prefHeight="40.0"
                            prefWidth="332.0">
                        <children>
                            <PasswordField
                                    fx:id="loginPassword"
                                    prefHeight="38.0" prefWidth="267.0"
                                    promptText="Password"
                                    style="-fx-background-radius: 50; -fx-border-radius: 50;">
                                <font><Font size="14.0" /></font>
                            </PasswordField>
                        </children>
                        <VBox.margin><Insets top="10.0" /></VBox.margin>
                    </HBox>

                    <!--LOGIN MESSAGE (ERROR/DISPLAY)-->
                    <Label
                            fx:id="loginMessage"
                            textFill="red"
                            alignment="CENTER"
                            prefWidth="332"
                            style="-fx-text-alignment: center;"/>

                    <!--LOGIN MESSAGE (SUCCESS)-->
                    <Label
                            fx:id="loginSuccess"
                            textFill="green"
                            alignment="CENTER"
                            prefWidth="332"
                            style="-fx-text-alignment: center;"/>

                    <!--Login Button-->
                    <HBox alignment="CENTER" prefHeight="40.0" prefWidth="332.0">
                        <VBox.margin><Insets top="10.0" /></VBox.margin>
                        <children>
                            <Button
                                    fx:id="loginButton"
                                    text="Login"
                                    textFill="#2acbd4"
                                    prefHeight="38.0" prefWidth="267.0"
                                    mnemonicParsing="false"
                                    onAction="#handleLogin"
                                    style="-fx-background-radius: 50; -fx-border-radius: 50;">
                                <font><Font name="System Bold" size="18.0" /></font>

                                <styleClass>
                                    <String fx:value="login_button2" />
                                    <String fx:value="cursor_hand" />
                                </styleClass>

                            </Button>
                        </children>
                    </HBox>

                </VBox>

                <!--SIGNUP FORM-->
                <VBox fx:id="signupForm" visible="false">

                    <!--Username-->
                    <HBox alignment="CENTER" prefHeight="40.0" prefWidth="332.0">
                        <children>
                            <TextField
                                    fx:id="signupUsername"
                                    prefHeight="38.0" prefWidth="267.0"
                                    promptText="Create Username"
                                    style="-fx-background-radius: 50; -fx-border-radius: 50;">
                                <font><Font size="14.0" /></font>
                            </TextField>
                        </children>
                        <VBox.margin><Insets top="20.0" /></VBox.margin>
                    </HBox>

                    <!--Password-->
                    <HBox alignment="CENTER" prefHeight="40.0" prefWidth="332.0">
                        <children>
                            <PasswordField
                                    fx:id="signupPassword"
                                    prefHeight="38.0" prefWidth="267.0"
                                    promptText="Create Password"
                                    style="-fx-background-radius: 50; -fx-border-radius: 50;">
                                <font><Font size="14.0" /></font>
                            </PasswordField>
                        </children>
                        <VBox.margin><Insets top="10.0" /></VBox.margin>
                    </HBox>

                    <!--Confirm Password-->
                    <HBox alignment="CENTER" prefHeight="40.0" prefWidth="332.0">
                        <children>
                            <PasswordField
                                    fx:id="confirmPassword"
                                    prefHeight="38.0" prefWidth="267.0"
                                    promptText="Confirm Password"
                                    style="-fx-background-radius: 50; -fx-border-radius: 50;">
                                <font><Font size="14.0" /></font>
                            </PasswordField>
                        </children>
                        <VBox.margin><Insets top="10.0" /></VBox.margin>
                    </HBox>

                    <!--SIGNUP MESSAGE (ERROR/DISPLAY)-->
                    <Label
                            fx:id="signupMessage"
                            textFill="red"
                            alignment="CENTER"
                            prefWidth="332"
                            style="-fx-text-alignment: center;"/>

                    <Label
                            fx:id="signupSuccess"
                            textFill="green"
                            alignment="CENTER"
                            prefWidth="332"
                            style="-fx-text-alignment: center;"/>

                    <!--Signup Button-->
                    <HBox alignment="CENTER" prefHeight="40.0" prefWidth="332.0">
                        <VBox.margin><Insets top="10.0" /></VBox.margin>
                        <children>
                            <Button
                                    fx:id="signupButton"
                                    text="Sign Up"
                                    textFill="#2acbd4"
                                    prefHeight="38.0" prefWidth="267.0"
                                    mnemonicParsing="false"
                                    onAction="#handleSignup"
                                    style="-fx-background-radius: 50; -fx-border-radius: 50;">
                                <font><Font name="System Bold" size="18.0" /></font>

                                <styleClass>
                                    <String fx:value="login_button2" />
                                    <String fx:value="cursor_hand" />
                                </styleClass>

                            </Button>
                        </children>
                    </HBox>

                </VBox>

            </children>
        </VBox>
    </right>

    <!--CENTER (TITLE + LOGO SECTION)-->
    <center>
        <VBox prefWidth="449.0" styleClass="vbox_background_center" BorderPane.alignment="CENTER">
            <children>

                <!--Top-Right Buttons (Login / Signup Toggle)-->
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <HBox alignment="CENTER_RIGHT" prefHeight="94.0" prefWidth="412.0">
                            <children>

                                <Button
                                        fx:id="leftSignUpButton"
                                        text="Sign up"
                                        textFill="#222222"
                                        prefHeight="37.0" prefWidth="90.0"
                                        onAction="#showSignupForm"
                                        style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: #FFAE42;">
                                    <font><Font name="System Bold" size="16.0" /></font>
                                    <styleClass>
                                        <String fx:value="signup_button" />
                                        <String fx:value="cursor_hand" />
                                    </styleClass>
                                    <HBox.margin><Insets right="5.0" /></HBox.margin>
                                </Button>

                                <Button
                                        fx:id="leftLoginButton"
                                        text="Login"
                                        textFill="#222222"
                                        prefHeight="37.0" prefWidth="90.0"
                                        onAction="#showLoginForm"
                                        style="-fx-background-radius: 50; -fx-border-radius: 50; -fx-border-color: #FFAE42;">
                                    <font><Font name="System Bold" size="16.0" /></font>
                                    <styleClass>
                                        <String fx:value="login_button1" />
                                        <String fx:value="cursor_hand" />
                                    </styleClass>
                                </Button>

                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!--Title-->
                <VBox>
                    <children>
                        <HBox alignment="BOTTOM_CENTER">
                            <children>
                                <Text text="STICK" fill="WHITE">
                                    <font><Font name="Impact" size="48.0" /></font>
                                    <effect><Glow level="0.15" /></effect>
                                </Text>

                                <Text text="to" fill="#68a0b0">
                                    <font><Font name="Impact" size="48.0" /></font>
                                    <HBox.margin><Insets left="15.0" /></HBox.margin>
                                </Text>
                            </children>
                        </HBox>

                        <HBox alignment="TOP_CENTER">
                            <children>
                                <Text text="the" fill="#68a0b0">
                                    <font><Font name="Impact" size="48.0" /></font>
                                </Text>

                                <Text text="PLAN" fill="WHITE">
                                    <font><Font name="Impact" size="48.0" /></font>
                                    <HBox.margin><Insets left="15.0" /></HBox.margin>
                                    <effect><Glow level="0.15" /></effect>
                                </Text>
                            </children>
                        </HBox>

                    </children>
                </VBox>

                <!--Logo-->
                <HBox alignment="CENTER" prefHeight="198.0">
                    <children>
                        <ImageView fitHeight="215.0" fitWidth="233.0" preserveRatio="true">
                            <image><Image url="@Logo.PNG" /></image>
                            <effect><Reflection fraction="0.12" topOpacity="0.25" /></effect>
                        </ImageView>
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>




